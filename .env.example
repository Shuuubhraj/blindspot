# Blindspot environment configuration.
# Copy to .env (project root) and adjust. All values below are the defaults.

# --- data locations ---
# Base directory for runtime data (DB, workspaces, uploads).
BLINDSPOT_DATA_DIR=./backend/blindspot/data
# The three paths below default to locations under BLINDSPOT_DATA_DIR and
# can be overridden individually when needed.

# --- server ---
BLINDSPOT_HOST=127.0.0.1
BLINDSPOT_PORT=8000

# --- CLI: where the `blindspot` CLI looks for the API (CLI-only variable) ---
BLINDSPOT_URL=http://127.0.0.1:8000

# --- auth: empty = no auth (single-user localhost). Set to require X-API-Token ---
BLINDSPOT_API_TOKEN=

# --- storage ---
BLINDSPOT_DATABASE_URL=sqlite:////home/hatch/workspace/blindspot-mobile/backend/blindspot/data/blindspot.db
BLINDSPOT_WORKSPACE=/home/hatch/workspace/blindspot-mobile/backend/blindspot/workspaces
BLINDSPOT_UPLOADS=/home/hatch/workspace/blindspot-mobile/backend/blindspot/uploads

# --- limits ---
BLINDSPOT_MAX_UPLOAD_MB=200
BLINDSPOT_MAX_EXTRACT_MB=1024
BLINDSPOT_MAX_EXTRACT_FILES=20000
BLINDSPOT_SCAN_TIMEOUT_S=1800
BLINDSPOT_TOOL_TIMEOUT_S=600
BLINDSPOT_RETENTION_DAYS=30

# --- local AI review (Ollama). No cloud fallback exists. ---
BLINDSPOT_OLLAMA_URL=http://127.0.0.1:11434
BLINDSPOT_AI_DEFAULT=0
BLINDSPOT_AI_MODEL=
BLINDSPOT_AI_TIMEOUT_S=300
BLINDSPOT_AI_MAX_FILES=12
BLINDSPOT_AI_MAX_CHARS_PER_FILE=4000
